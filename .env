# Base URL for the future backend / CMS API.
# Leave empty during frontend-only development — services/inquiryService.js
# falls back to a mocked response when this is not set.
VITE_API_BASE_URL=

# Public URL this site will be deployed to (used by the SEO component
# for canonical URLs and Open Graph tags).
VITE_SITE_URL=https://digiinsaf.com

# Contact email shown across the site and used as a fallback
# "reply-to" once the backend contact endpoint is connected.
VITE_CONTACT_EMAIL=info@digiinsaf.com

# Chatbot feature flag and mode — see .env.example for details.
VITE_CHATBOT_ENABLED=true
VITE_CHATBOT_API_URL=
VITE_CHATBOT_PROVIDER=local
