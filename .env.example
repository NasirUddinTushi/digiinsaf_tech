# Base URL for the future backend / CMS API.
# Leave empty during frontend-only development — services/inquiryService.js
# falls back to a mocked response when this is not set.
VITE_API_BASE_URL=

# Public URL this site will be deployed to (used by the SEO component
# for canonical URLs and Open Graph tags).
VITE_SITE_URL=https://digiinsaf.com

# Contact email shown across the site and used as a fallback
# "reply-to" once the backend contact endpoint is connected.
VITE_CONTACT_EMAIL=info@digiinsaf.com

# Chatbot feature flag — set to "false" to hide the chat widget entirely.
VITE_CHATBOT_ENABLED=true

# Base URL for the chatbot's own backend/AI-proxy (kept separate from
# VITE_API_BASE_URL — a chatbot backend is often a different service).
# Leave empty to keep the chatbot fully local (rule-based, no network calls).
VITE_CHATBOT_API_URL=

# Which provider the backend at VITE_CHATBOT_API_URL proxies to for
# messages the local FAQ/service matching can't answer. One of:
#   local  -> no AI provider; rule-based answers only (default)
#   openai | claude | gemini | custom -> backend decides how to call that
#             provider; the browser never calls it directly and no API key
#             is ever placed in frontend code.
VITE_CHATBOT_PROVIDER=local
